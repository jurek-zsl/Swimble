# ==============================================================================
# Swimble .gitignore
# Native macOS Mumble VoIP Client (Rust Core + SwiftUI Liquid Glass Frontend)
# ==============================================================================

# --- macOS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# --- Rust & Cargo ---
/target/
**/target/
**/*.rs.bk
Cargo.lock.orig

# --- Compiled Libraries & Binaries ---
*.a
*.o
*.dylib
*.so
*.dll
*.rlib
MacClient/Generated/*.a

# --- Xcode & Swift Build Artifacts ---
build/
DerivedData/
*.build/
*.app
*.dSYM/
*.ipa
.build/

# --- Xcode User Data & State ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# (Optional) XcodeGen: Swimble.xcodeproj is generated by `xcodegen generate`
# Uncomment the line below if you prefer generating the project locally only:
# *.xcodeproj/

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*~
*.bak

# --- Logs, Diagnostics & Crash Dumps ---
*.log
*.crash
*.dmp
